<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="1060" Height="650" MinWidth="640" MinHeight="400" WindowStartupLocation="Manual" Background="#07121C" FontFamily="Segoe UI" Foreground="White" ShowActivated="False">
 <Viewbox Stretch="Uniform"><Grid Width="1920" Height="1080" x:Name="SceneRoot" ClipToBounds="True">
  <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#06131D" Offset="0"/><GradientStop x:Name="ThemeStop" Color="#153733" Offset="1"/></LinearGradientBrush></Grid.Background>
  <Grid x:Name="ArtHost" IsHitTestVisible="False"/>
  <Border Margin="70,66,70,66" BorderThickness="1" BorderBrush="#1FFFFFFF" CornerRadius="30"/>
  <Rectangle x:Name="AccentLine" Width="6" Height="128" Fill="#64E5CD" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="108,200,0,0"/>
  <StackPanel Margin="148,110,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
   <TextBlock x:Name="RoomLabel" Text="SALA 01" FontSize="24" FontWeight="Bold" Foreground="#64E5CD"/>
   <TextBlock x:Name="RoomTitle" Text="CRISE&#x0a;CLIMÁTICA" FontSize="66" FontWeight="SemiBold" LineHeight="73" LineStackingStrategy="BlockLineHeight" Margin="0,35,0,0"/>
   <TextBlock x:Name="RoomTagline" Text="O planeta precisa de equilíbrio." FontSize="26" Foreground="#BDD6DE" Margin="0,23,0,0"/>
  </StackPanel>
  <Image x:Name="EventLogo" Width="220" Height="150" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,80,125,0"/>
  <Border x:Name="StatusBadge" Background="#213B3B" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="20" Margin="148,450,0,0" Padding="22,10">
   <TextBlock x:Name="StatusText" Text="AGUARDANDO INÍCIO" FontSize="18" FontWeight="Bold" Foreground="#64E5CD"/>
  </Border>
  <Viewbox Width="1070" Height="265" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="127,504,0,0" Stretch="Uniform">
   <TextBlock x:Name="TimeDisplay" Text="60:00" FontSize="270" FontFamily="Bahnschrift" FontWeight="SemiBold" Foreground="#F2FAFF"/>
  </Viewbox>
  <TextBlock x:Name="Detail" Text="Um relógio. Três salas. Uma missão." FontSize="25" Foreground="#BCD0DB" Margin="148,804,0,0" Width="1030" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Top"/>
  <Border Background="#283746" Height="6" Width="1020" Margin="148,914,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="3">
   <Grid ClipToBounds="True"><Border x:Name="Progress" Background="#64E5CD" Width="1020" HorizontalAlignment="Left" CornerRadius="3"/></Grid>
  </Border>
  <TextBlock x:Name="Motto" Text="OBSERVE. INVESTIGUE. TRANSFORME." FontSize="16" FontWeight="SemiBold" Foreground="#93B2C4" Margin="148,953,0,0" VerticalAlignment="Top"/>
  <TextBlock Text="F2 · CONTROLE" FontSize="12" Foreground="#7D91A6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,108,42"/>
 </Grid></Viewbox>
</Window>
